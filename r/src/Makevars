# Uebersetzung (seit 1.6.0 nur C++: Bibliothek slc slc*.cpp, geteilte Kerne *_core.cpp mit
# *_core_impl.h, Huellen slc_r*.cpp und init.cpp; bis 1.5.2 slc als C99 mit eigenen Regeln).
# Gleiche Schalter fuer alle Dateien und wie python/setup.py und julia/deps/build.jl:
# -std=gnu++17 (CXX_STD), -O2 (setzt R ueber CXXFLAGS), kein Zusammenziehen zu fma, kein fast-math.
# SIMLEV_FP_CONTRACT_BY_FLAG: das GCC-Pragma der geteilten Kerne entfaellt (Flag statt Pragma).
# Die Kerndateien brechen bei __FAST_MATH__ ab (slc_internal.h, *_core_impl.h).
# Parallele Starts des MS-GARCH-Fits mit POSIX-Threads (SLC_THREADS, nur slc_msgarch.cpp nutzt es;
# Makevars.win ohne, dort laufen die Starts nacheinander, Ergebnis gleich).
CXX_STD = CXX17
PKG_CPPFLAGS = -DSIMLEV_FP_CONTRACT_BY_FLAG -DSLC_THREADS
PKG_CXXFLAGS = -ffp-contract=off -fno-fast-math -pthread
PKG_LIBS = -pthread

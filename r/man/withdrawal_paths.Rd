b <- bootstrap(d, cfg, "stationary", n = 20, params = list(L = 50),
               path_length = 3653, seed = 1, progress = FALSE)
wp <- withdrawal_paths(b, column = "us", inflation = "infl", inflation_type = "rate_pa")
dim(wp$returns)           # 10 Jahre x 20 Pfade

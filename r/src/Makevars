# Gleitkomma der C-Bibliothek slc (Entwurf C.2/C.3, Etappe 9.1): C99, kein Zusammenziehen zu fma,
# kein fast-math; gleiche Flags wie python/setup.py und julia/deps/build.jl (-O2 setzt R ueber CFLAGS).
# Die Flags gelten nur fuer die slc-Dateien (eigene Variable und ausdrueckliche Regeln statt
# PKG_CFLAGS, damit die uebrigen C-Dateien unveraendert uebersetzt werden). Die Kerndateien brechen
# bei __FAST_MATH__ ab (slc_internal.h).
SLC_CFLAGS = -std=c99 -ffp-contract=off -fno-fast-math

# erstes Ziel: die Bibliothek (sonst wuerde die erste Regel unten das Standardziel)
all: $(SHLIB)

slc_ctx.o: slc_ctx.c slc.h slc_internal.h slc_constants.h
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(SLC_CFLAGS) -c slc_ctx.c -o slc_ctx.o

slc_normal.o: slc_normal.c slc.h slc_internal.h slc_constants.h
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(SLC_CFLAGS) -c slc_normal.c -o slc_normal.o

slc_rng.o: slc_rng.c slc.h slc_internal.h slc_constants.h
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(SLC_CFLAGS) -c slc_rng.c -o slc_rng.o

slc_sample.o: slc_sample.c slc.h slc_internal.h slc_constants.h
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(SLC_CFLAGS) -c slc_sample.c -o slc_sample.o

slc_special.o: slc_special.c slc.h slc_internal.h slc_constants.h
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(SLC_CFLAGS) -c slc_special.c -o slc_special.o

slc_r.o: slc_r.c slc.h
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(SLC_CFLAGS) -c slc_r.c -o slc_r.o

# 9.2: Kerne der Etappe 9.2 und ihre Huelle slc_r_linalg.c (gleiche Flags)
